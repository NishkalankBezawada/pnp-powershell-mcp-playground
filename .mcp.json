{
  "mcpServers": {
    "pnp-powershell": {
      "type": "stdio",
      "command": "dnx",
      "args": [
        "PnP.PowerShell.MCPServer@0.1.6-beta",
        "--yes"
      ],
      "env": {
        "PNP_SCRIPT_SAMPLES_PATH": "",
        "PNP_MCP_CONFIRM_DESTRUCTIVE": "true",
        "PNP_MCP_COMMAND_TIMEOUT_SECONDS": "1800"
      }
    }
  }
}