# The value passed to -Tenant. Connect-PnPOnline documents this as the tenant
# NAME, e.g. contoso.onmicrosoft.com, or a custom domain you have added.
# Prefer this over PNP_TENANT_ID.
PNP_TENANT=

# Directory (tenant) ID from Entra ID. Used as a fallback for -Tenant when
# PNP_TENANT is empty, and handy to have recorded either way.
PNP_TENANT_ID=
# Application (client) ID of the Entra ID app registration.
# Create one with Register-PnPEntraIDApp - see notes.md before you run it, the
# default permission grant is full control of every site in the tenant.
PNP_CLIENT_ID=

# Default site the script connects to.
PNP_SITE_URL=

# Tenant admin site. Passed as -TenantAdminUrl on every connect, and used as
# the target when the script is run with -Admin.
# Tenant-wide cmdlets (Get-PnPTenantSite, Set-PnPTenant, ...) need a connection
# to this host; PnP will not silently elevate an ordinary site connection.
PNP_ADMIN_SITE_URL=


# Certificate - supply EXACTLY ONE of the three below
#  The script refuses to run if none or more than one is set, rather than
#  guessing which you meant. Precedence is irrelevant because ambiguity is an
#  error, not a fallback.
#
#  !! PNP_CERT_BASE64 and PNP_CERT_PASSWORD are REAL SECRETS - they carry or
#  !! unlock the private key. PNP_CERT_THUMBPRINT, the tenant id and the client
#  !! id are only identifiers. Keep `.env` out of git regardless.

# 1. Path to a .pfx containing the private key -> -CertificatePath
#    Relative paths resolve from the repo root. `certs/` and *.pfx are gitignored.
PNP_CERT_PATH=

# 2. The same .pfx, base64 encoded as a single line -> -CertificateBase64Encoded
#    Produce it with:
#      [Convert]::ToBase64String([IO.File]::ReadAllBytes('certs/certificate.pfx'))
#    Useful in CI, where a file on disk is awkward but a secret variable is not.
PNP_CERT_BASE64=

# 3. Thumbprint of a certificate already imported into the Windows certificate
#    store (CurrentUser\My) -> -Thumbprint. Windows only; no password needed.
PNP_CERT_THUMBPRINT=

# Password protecting the .pfx. Required for most .pfx files when using
# PNP_CERT_PATH or PNP_CERT_BASE64. Leave empty for a passwordless .pfx, or
# when using PNP_CERT_THUMBPRINT.
PNP_CERT_PASSWORD=
